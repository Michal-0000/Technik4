<Window x:Class="GaleriaObrazow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GaleriaObrazow"
        mc:Ignorable="d"
        Title="Galeria obrazów" Height="450" Width="800">
    <Grid Background="Beige">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0">
            <ListView x:Name="listViewImages" Background="Beige" SelectionChanged="listViewImages_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding ImageSource}" Width="100" Margin="5,20"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
        <StackPanel Orientation="Vertical" Grid.Column="1">
            <Label Name="lblOpis" Content="" FontWeight="Bold"/>
            <Image Name="imgObraz" Margin="5, 20, 5, 20"/>
        </StackPanel>
    </Grid>
</Window>
