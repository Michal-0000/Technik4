<Window x:Class="AlfabetMorsa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlfabetMorsa"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Left" Margin="5">
            <Label Content="Morse'a"/>
            <TextBox Name="txtMorse" Width="600" Height="100" Background="#EEEEEE" TextChanged="txtMorse_TextChanged"/>

            <Label Content="Odkryty"/>
            <TextBox Name="txtNormal" Width="600" Height="100" Background="#EEEEEE" TextChanged="txtNormal_TextChanged"/>
        </StackPanel>
    </Grid>
</Window>
